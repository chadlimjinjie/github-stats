DATABASE_URL=postgres://postgres:postgres@localhost/midtone
AUTH_SERVICE_URL=http://localhost:4112
AUTH_TENANT=midtone
PORT=4106
# Fine-grained PAT with no scopes: read-only public data
GITHUB_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a redirect URI registered in the Spotify app
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9080/stats/spotify/callback
# 64 hex chars; encrypts Spotify refresh tokens and OAuth state
STATS_ENCRYPTION_KEY=
WEB_STATS_URL=http://localhost:5177
